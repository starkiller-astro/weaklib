  wlEquationOfStateTableModule.o

wlTestEmAb4DVsGSI.o: \
  wlKindModule.o \
  wlEosConstantsModule.o \
  wlSemiLeptonicOpacityModule2D.o \
  wlSemiLeptonicOpacityModule4D.o \
  Opacity_SemiLep_2D_GSI.o \
  Opacity_SemiLep_4D_GSI.o

wlTestEmAb4DParallel.o: \
  wlKindModule.o \
  wlEosConstantsModule.o \
  wlSemiLeptonicOpacityModule4D.o

wlCompareEmAbApproximations.o: \
  wlKindModule.o \
  wlEosConstantsModule.o \
  wlInterpolationModule.o \
  wlEquationOfStateTableModule.o \
  wlIOModuleHDF.o \
  wlEOSIOModuleHDF.o \
  wlLeptonEOSTableModule.o \
  wlLeptonPhotonGasEOS.o \
  wlHelmIOModuleHDF.o \
  wlSemiLeptonicOpacityModule2D.o \
  wlCalculateEmAbOpacityModule.o \
  wlOpacityTableModule.o \
  wlOpacityTableIOModuleHDF.o \
  wlOpacityFieldsModule.o

wlCompareEmAbApproximationsTable.o: \
  wlKindModule.o \
  wlEosConstantsModule.o \
  wlInterpolationModule.o \
  wlEquationOfStateTableModule.o \
  wlIOModuleHDF.o \
  wlEOSIOModuleHDF.o \
  wlLeptonEOSTableModule.o \
  wlLeptonPhotonGasEOS.o \
  wlHelmIOModuleHDF.o \
  wlSemiLeptonicOpacityModule2D.o \
  wlCalculateEmAbOpacityModule.o \
  wlOpacityTableModule.o \
