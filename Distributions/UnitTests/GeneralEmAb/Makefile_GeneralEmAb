wlTestAbEm2DConvergence.o: \
  wlKindModule.o \
  wlEosConstantsModule.o \
  wlSemiLeptonicOpacityModule2D.o

wlTestAbEm2DCompareSchemes.o: \
  wlKindModule.o \
  wlEosConstantsModule.o \
  wlSemiLeptonicOpacityModule2D.o

wlTestAbEm2DFastSettings.o: \
  wlKindModule.o \
  wlEosConstantsModule.o \
  wlSemiLeptonicOpacityModule2D.o

wlTestAbEm2DVsTable.o: \
  wlKindModule.o \
