wlTestEmAb2DConvergence.o: \
  wlKindModule.o \
  wlEosConstantsModule.o \
  wlSemiLeptonicOpacityModule2D.o

wlTestEmAb2DCompareSchemes.o: \
  wlKindModule.o \
  wlEosConstantsModule.o \
  wlSemiLeptonicOpacityModule2D.o

wlTestEmAb2DFastSettings.o: \
  wlKindModule.o \
  wlEosConstantsModule.o \
  wlSemiLeptonicOpacityModule2D.o

wlTestEmAb2DVsTable.o: \
  wlKindModule.o \
  wlEosConstantsModule.o \
