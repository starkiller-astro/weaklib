WEAKLIB_DIR ?= $(HOME)/weaklib
include $(WEAKLIB_DIR)/Distributions/Build/Makefile_Build
include $(WEAKLIB_DIR)/Distributions/Build/Makefile_WeakLib_ObjectFiles
include $(WEAKLIB_DIR)/Distributions/Build/Makefile_WeakLib_Dependencies

# Needed only by the 'compare' targets (cc_weak_mag_weaklib and its modules)
include $(WEAKLIB_DIR)/TableCreator/OpacitySource/FullWeakPhysics/Makefile_Opacity_FullWeakPhysics_ObjectFiles
include $(WEAKLIB_DIR)/TableCreator/OpacitySource/FullWeakPhysics/Makefile_Opacity_FullWeakPhysics_Dependencies
include $(WEAKLIB_DIR)/TableCreator/OpacitySource/FullWeakPhysics/Chimera/Makefile_ObjectFiles
include $(WEAKLIB_DIR)/TableCreator/OpacitySource/FullWeakPhysics/Chimera/Makefile_Dependencies

VPATH += \
$(WEAKLIB_DIR)/TableCreator/OpacitySource/FullWeakPhysics: \
$(WEAKLIB_DIR)/TableCreator/OpacitySource/FullWeakPhysics/Chimera: \
$(WEAKLIB_DIR)/Distributions/OpacitySource/GeneralEmAb/OriginalGSIroutines

# CUBA (Vegas) is only needed by the 4D kernels: link it only when requested
ifeq ($(USE_CUBA),TRUE)
  CUBA_LIB = -L$(CUBA_DIR) -lcuba
else
  CUBA_LIB =
endif

CHIMERA_WM = \
  numerical_module.o \
  physcnst_module.o \
  PRB_CNTL_MODULE.o \
  cc_weak_mag_weaklib.o

.DEFAULT_GOAL := all

# Default: 2D kernels only, no CUBA needed
all: wlTestEmAb2DVsGSI \
     wlTestEmAb2DParallel \
     wlTestEmAb2DConvergence \
     wlTestEmAb2DCompareSchemes \
     wlTestEmAb2DFastSettings \
     wlTestEmAb2DVsTable

# 4D (CUBA) kernels: make cuba USE_CUBA=TRUE
cuba: check_cuba \
      wlTestEmAb4DVsGSI \
      wlTestEmAb4DParallel

# Comparison with elastic approximation / tables (needs EOS + opacity tables)
compare: wlCompareEmAbApproximations \
         wlCompareEmAbApproximationsTable

check_cuba:
ifneq ($(USE_CUBA),TRUE)
	$(error The 'cuba' targets require USE_CUBA=TRUE (and CUBA_DIR set))
endif

wlTestEmAb2DVsGSI: \
	$(weaklib) Opacity_SemiLep_2D_GSI.o wlTestEmAb2DVsGSI.o
	$(FLINKER) $(FLAGS) -o wlTestEmAb2DVsGSI_$(MACHINE) \
	$(weaklib) Opacity_SemiLep_2D_GSI.o wlTestEmAb2DVsGSI.o \
	$(LIBRARIES) $(CUBA_LIB)

wlTestEmAb2DParallel: \
	$(weaklib) wlTestEmAb2DParallel.o
	$(FLINKER) $(FLAGS) -o wlTestEmAb2DParallel_$(MACHINE) \
	$(weaklib) wlTestEmAb2DParallel.o \
	$(LIBRARIES) $(CUBA_LIB)

wlTestEmAb2DConvergence: \
	$(weaklib) wlTestEmAb2DConvergence.o
	$(FLINKER) $(FLAGS) -o wlTestEmAb2DConvergence_$(MACHINE) \
	$(weaklib) wlTestEmAb2DConvergence.o \
	$(LIBRARIES) $(CUBA_LIB)

wlTestEmAb2DCompareSchemes: \
	$(weaklib) wlTestEmAb2DCompareSchemes.o
	$(FLINKER) $(FLAGS) -o wlTestEmAb2DCompareSchemes_$(MACHINE) \
	$(weaklib) wlTestEmAb2DCompareSchemes.o \
	$(LIBRARIES) $(CUBA_LIB)

wlTestEmAb2DFastSettings: \
	$(weaklib) wlTestEmAb2DFastSettings.o
	$(FLINKER) $(FLAGS) -o wlTestEmAb2DFastSettings_$(MACHINE) \
	$(weaklib) wlTestEmAb2DFastSettings.o \
	$(LIBRARIES) $(CUBA_LIB)

wlTestEmAb2DVsTable: \
	$(weaklib) wlTestEmAb2DVsTable.o
	$(FLINKER) $(FLAGS) -o wlTestEmAb2DVsTable_$(MACHINE) \
	$(weaklib) wlTestEmAb2DVsTable.o \
	$(LIBRARIES) $(CUBA_LIB)

wlTestEmAb4DVsGSI: \
	$(weaklib) Opacity_SemiLep_2D_GSI.o Opacity_SemiLep_4D_GSI.o wlTestEmAb4DVsGSI.o
	$(FLINKER) $(FLAGS) -o wlTestEmAb4DVsGSI_$(MACHINE) \
	$(weaklib) Opacity_SemiLep_2D_GSI.o Opacity_SemiLep_4D_GSI.o wlTestEmAb4DVsGSI.o \
	$(LIBRARIES) $(CUBA_LIB)

wlTestEmAb4DParallel: \
	$(weaklib) wlTestEmAb4DParallel.o
	$(FLINKER) $(FLAGS) -o wlTestEmAb4DParallel_$(MACHINE) \
	$(weaklib) wlTestEmAb4DParallel.o \
	$(LIBRARIES) $(CUBA_LIB)

wlCompareEmAbApproximations: \
	$(weaklib) wlCompareEmAbApproximations.o
	$(FLINKER) $(FLAGS) -o wlCompareEmAbApproximations_$(MACHINE) \
	$(weaklib) wlCompareEmAbApproximations.o \
	$(LIBRARIES) $(CUBA_LIB)

wlCompareEmAbApproximationsTable: \
	$(weaklib) $(CHIMERA_WM) wlCompareEmAbApproximationsTable.o
	$(FLINKER) $(FLAGS) -o wlCompareEmAbApproximationsTable_$(MACHINE) \
	$(weaklib) $(CHIMERA_WM) wlCompareEmAbApproximationsTable.o \
	$(LIBRARIES) $(CUBA_LIB)

clean:
	rm -f *.o *.mod *.ld *.acc.s

clobber: clean
	rm -f *_$(MACHINE)

.PHONY: all cuba compare check_cuba clean clobber

numerical_module.o: \
  wlKindModule.o

physcnst_module.o: \
  wlKindModule.o \
  numerical_module.o

PRB_CNTL_MODULE.o: \
  wlKindModule.o

cc_weak_mag_weaklib.o: \
