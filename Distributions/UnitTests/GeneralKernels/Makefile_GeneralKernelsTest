.DEFAULT_GOAL := all

all: wlTestElasticOpacity \
     wlTestFig56Guo \
     wlTestFig2Fischer \
     wlTestGeneralKernelVsTable \
     wlTestGeneralKernelNMS \
     wlTestGeneralKernelTwoReactions \
     wlTestGeneralKernelNMS_Point \
     wlTestGeneralKernelVsTable_Interface

